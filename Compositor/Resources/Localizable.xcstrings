    },
    "Some dropped items couldn’t be read. Drag JPEG, PNG, GIF, HEIC, HEIF, TIFF, WebP, PDF, or Photoshop (PSD) files from Finder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
