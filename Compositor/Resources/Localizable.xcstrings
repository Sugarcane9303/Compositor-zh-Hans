    },
    "Straightens vertical lines toward the center.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将垂直线向中心校正。"
          }
        }
      }
    },
    "Strength": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强度"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等量增强或减弱所有颜色。"
          }
        }
      }
    },
    "Strengthens or weakens the blue primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱蓝色原色。"
          }
        }
      }
    },
    "Strengthens or weakens the green primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱绿色原色。"
          }
        }
      }
    },
    "Strengthens or weakens the red primary.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱红色原色。"
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对柔和的颜色比对已浓的颜色增强更多，并保护肤色。"
          }
        }
      }
    },
    "Stretches width relative to height.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对于高度拉伸宽度。"
          }
        }
      }
    },
    "Stroke": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描边"
          }
        }
      }
    },
    "Strong Contrast": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强对比度"
          }
        }
      }
    },
    "Studio Display": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Studio Display"
          }
        }
      }
    },
    "Style": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "样式"
          }
        }
