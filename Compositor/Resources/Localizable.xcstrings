    },
    "Subdivisions": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "细分"
          }
        }
      }
    },
    "Subject": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主体"
          }
        }
      }
    },
    "Subtract": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减去"
          }
        }
      }
    },
    "Swap From and To: blur the start and sharpen toward the end": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换起点和终点：起点模糊，向终点锐化"
          }
        }
      }
    },
    "Swap colors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换颜色"
          }
        }
      }
    },
    "Swap foreground and background (X)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换前景色和背景色（X）"
          }
        }
      }
    },
    "Swap foreground/background": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换前景色/背景色"
          }
        }
      }
