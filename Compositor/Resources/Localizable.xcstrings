    "“%@” already exists. Replace it?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 已存在。要替换它吗？"
          }
        }
      }
    },
    "“%@” has no images to import.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”没有可导入的图像。"
          }
        }
      }
    },
    "“%@” has nothing to export": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 没有可导出的内容"
          }
        }
      }
    },
    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是文件夹，自身没有像素。请在其中某个图层上绘制，或在文件夹的蒙版上绘制。"
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是调整图层，没有可绘制的像素。请在其蒙版上绘制。"
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已隐藏，或位于隐藏的文件夹中。请显示它以便在其上绘制。"
          }
        }
      }
    },
    "“%@” was changed on disk.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已在磁盘上被更改。"
          }
