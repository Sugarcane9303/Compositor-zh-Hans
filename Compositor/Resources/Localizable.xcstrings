        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留透明区域"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在明度平滑后保持局部对比度。"
